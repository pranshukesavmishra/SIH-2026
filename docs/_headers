# Netlify headers.
#
# The live tracker is the one page that gets iterated on right up to a demo,
# and a browser silently serving a cached copy means testing a version that no
# longer exists -- a fault that looks exactly like "the fix did nothing".
/live.html
  Cache-Control: no-store, must-revalidate

# Team-only pages: reachable by their address, never listed or indexed.
/build.html
  X-Robots-Tag: noindex, nofollow
/build
  X-Robots-Tag: noindex, nofollow
